ecuteAdHocQuery(sql: string) : DataTable&#xa;+ QueryAxDbView(viewName: string) : DataTable" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontSize=11;" vertex="1" parent="20"><mxGeometry x="1560" y="140" width="660" height="200" as="geometry"/></mxCell><mxCell id="22" value="&amp;lt;&amp;lt;windows scheduler (13 Batches)&amp;gt;&amp;gt;&#xa;&lt;b&gt;BatchScheduleCoordinator&lt;/b&gt;&#xa;--&#xa;+ ActiveBatchCount : int = 13&#xa;+ DyxnetTimeoutMs : int = 15000&#xa;+ RetryThreshold : int = 3&#xa;--&#xa;+ ExecuteSyncRsv() : BatchExecutionResult&#xa;+ ExecuteSyncRsg() : BatchExecutionResult&#xa;+ RunDailySewnReport() : void" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontSize=11;" vertex="1" parent="20"><mxGeometry x="1560" y="380" width="660" height="210" as="geometry"/></mxCell><mxCell id="23" value="&amp;lt;&amp;lt;rest client&amp;gt;&amp;gt;&#xa;&lt;b&gt;CqsIntegrationBridge&lt;/b&gt;&#xa;--&#xa;+ ArrProxyUrl : string = &#x27;http://192.168.0.23:8012&#x27;&#xa;+ KestrelDirectUrl : string = &#x27;http://192.168.0.23:8011&#x27;&#xa;--&#xa;+ SubmitInspection(data: InspectionDto) : bool&#xa;+ FetchInspectionStatus(moNo: string) : InspectionStatusDto" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontSize=11;" vertex="1" parent="20"><mxGeometry x="1560" y="630" width="660" height="210" as="geometry"/></mxCell><mxCell id="24" value="&amp;lt;&amp;lt;process runner&amp;gt;&amp;gt;&#xa;&lt;b&gt;TechPackCliInvoker&lt;/b&gt;&#xa;--&#xa;+ ExecutablePath : string = &#x27;python techpack_cli.py&#x27;&#xa;+ WorkingDir : string = &#x27;D:\EXP&#x27;&#xa;--&#xa;+ ExecuteExtraction(pdfPath: string) : ExtractedResult&#xa;+ SanitizeInput(path: string) : bool" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontSize=11;" vertex="1" parent="20"><mxGeometry x="1560" y="880" width="660" height="200" as="geometry"/></mxCell><mxCell id="25" value="呼叫跨庫資料" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="13" target="21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="排程同步觸發" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="22" target="13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" value="提交品管檢驗" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="16" target="23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="28" value="呼叫命令列解析" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="15" target="24"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d02_component" name="02. Component Diagram (元件圖)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;02. UML 2.0 Component Diagram (元件圖) — 系統模組邊界與整合介面&lt;/b&gt;&#xa;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;分類：結構型圖 (Structural) ｜ 專案：RSI 2027 蜂巢計畫 ｜ 資料來源：Duke 2026-11-12 交付架構 ｜ 備註：劃分三獨立子圖：總部地端核心微服務、D365 C# 服務整合層、YARP 零信任閘道防護處方&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;align=left;spacingLeft=20;verticalAlign=middle;fontSize=15;fontColor=#0f172a;shadow=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2220" height="55" as="geometry"/></mxCell><mxCell id="3" value="【子圖面板】子圖 A：台北總部機房地端核心元件 (RDSMP1 &amp; RDSMP2)" style="swimlane;horizontal=1;startSize=32;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e293b;rounded=1;arcSize=4;collapsible=0;shadow=0;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="700" height="1250" as="geometry"/></mxCell><mxCell id="4" value="&amp;lt;&amp;lt;legacy webforms&amp;gt;&amp;gt;&#xa;&lt;b&gt;RD_SAMPLE Web Site&lt;/b&gt;&#xa;--&#xa;• 執行環境: IIS 10.0 (RDSMP2: 192.168.0.22)&#xa;• 提供介面: HTTPS/443 UI, HTTP/80&#xa;• 1,490 Direct SQLs 直連 SAM_DB" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="3"><mxGeometry x="80" y="150" width="640" height="130" as="geometry"/></mxCell><mxCell id="5" value="&amp;lt;&amp;lt;modern microservice&amp;gt;&amp;gt;&#xa;&lt;b&gt;CQS 品質檢驗微服務&lt;/b&gt;&#xa;--&#xa;• 技術棧: .NET 8 Kestrel Core (:8011)&#xa;• 前端代理: IIS ARR (:8012) on RDSMP1&#xa;• 負責功能: 車縫樣品品質審核與回饋" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="3"><mxGeometry x="80" y="320" width="640" height="130" as="geometry"/></mxCell><mxCell id="6" value="&amp;lt;&amp;lt;background tasks&amp;gt;&amp;gt;&#xa;&lt;b&gt;Windows Batch Schedulers&lt;/b&gt;&#xa;--&#xa;• 宿主環境: RDSMP2 Windows Task Scheduler&#xa;• 核心任務: 13 支批次 .bat (D:\EXP)&#xa;• 含: SendNotification, Sync_RSV, Sync_RSG" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="3"><mxGeometry x="80" y="490" width="640" height="130" as="geometry"/></mxCell><mxCell id="7" value="&amp;lt;&amp;lt;subprocess utility&amp;gt;&amp;gt;&#xa;&lt;b&gt;TechPack CLI Parser (I04)&lt;/b&gt;&#xa;--&#xa;• 技術棧: Python 3 CLI Utility&#xa;• 觸發模式: 由 WebForms 以 Process.Start 叫用&#xa;• 負責功能: 解析版單 PDF/Excel 輸出 JSON" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="3"><mxGeometry x="80" y="660" width="640" height="130" as="geometry"/></mxCell><mxCell id="8" value="&amp;lt;&amp;lt;image microservice&amp;gt;&amp;gt;&#xa;&lt;b&gt;FindImage 比對微服務&lt;/b&gt;&#xa;--&#xa;• 執行節點: RDSMP2 (:8081)&#xa;• 負責功能: 樣品圖片相似度搜尋與重複檢核" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="3"><mxGeometry x="80" y="830" width="640" height="120" as="geometry"/></mxCell><mxCell id="9" value="反向代理轉送 (:8012 -&gt; :8011)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="程序呼叫 (CLI Subprocess)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="圖片特徵比對查詢" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="4" target="8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="【子圖面板】子圖 B：D365 C# 整合層 (RSIMDW1 &amp; D365 AOS)" style="swimlane;horizontal=1;startSize=32;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e293b;rounded=1;arcSize=4;collapsible=0;shadow=0;html=1;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="720" height="1250" as="geometry"/></mxCell><mxCell id="13" value="&amp;lt;&amp;lt;c# external plugin&amp;gt;&amp;gt;&#xa;&lt;b&gt;D365 Report.Service&lt;/b&gt;&#xa;--&#xa;• 執行環境: RSIMDW1 (:8085 正式 / :8082 測試)&#xa;• 驗證機制: 無驗證 (內部受信任網路模式)&#xa;• 提供介面: 12 項報表生成與匯出 API" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="12"><mxGeometry x="810" y="150" width="660" height="140" as="geometry"/></mxCell><mxCell id="14" value="&amp;lt;&amp;lt;c# custom service&amp;gt;&amp;gt;&#xa;&lt;b&gt;D365 Local.WebApi&lt;/b&gt;&#xa;--&#xa;• 執行環境: RSIMDW1 (:80 正式 / :8081 測試)&#xa;• 驗證機制: Azure AD Bearer Token 驗證&#xa;• 提供介面: 31 個服務模組、80 項 Operations" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="12"><mxGeometry x="810" y="330" width="660" height="140" as="geometry"/></mxCell><mxCell id="15" value="&amp;lt;&amp;lt;auth middleware&amp;gt;&amp;gt;&#xa;&lt;b&gt;Entra ID Token Validator&lt;/b&gt;&#xa;--&#xa;• 技術棧: Microsoft.IdentityModel.Tokens (C#)&#xa;• 公鑰輪替: 定期至 login.microsoftonline.com 抓取 JWKS&#xa;• 驗證範圍: 驗證 Local.WebApi 所有外部呼叫" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="12"><mxGeometry x="810" y="510" width="660" height="140" as="geometry"/></mxCell><mxCell id="16" value="&amp;lt;&amp;lt;database backend&amp;gt;&amp;gt;&#xa;&lt;b&gt;D365 AXDB 營運主庫&lt;/b&gt;&#xa;--&#xa;• 實例名稱: rsiaxdb1 (192.168.0.131)&#xa;• 連線模式: 23 處跨庫跨執行個體 View / Direct Query&#xa;• 權限規範: 唯讀存取，保障 ERP 核心交易安全" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="12"><mxGeometry x="810" y="690" width="660" height="140" as="geometry"/></mxCell><mxCell id="17" value="Token 授權校驗" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="跨庫資料唯讀查詢" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b91c1c;" edge="1" parent="1" source="4" target="16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" value="跨庫資料唯讀查詢" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="13" target="16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="【子圖面板】子圖 C：YARP 零信任安全閘道升級處方 (0 元開源平替)" style="swimlane;horizontal=1;startSize=32;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e293b;rounded=1;arcSize=4;collapsible=0;shadow=0;html=1;" vertex="1" parent="1"><mxGeometry x="1530" y="90" width="720" height="1250" as="geometry"/></mxCell><mxCell id="21" value="&amp;lt;&amp;lt;security gateway&amp;gt;&amp;gt;&#xa;&lt;b&gt;YARP 零信任閘道 (平替 ARR)&lt;/b&gt;&#xa;--&#xa;• 軟體架構: Microsoft YARP (.NET 8 邊界反向代理)&#xa;• 成本效益: 0 元開源，完全取代 IIS ARR 與付費硬體&#xa;• 部署節點: 地端 DMZ 入口 (連接埠 443 / 80)" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="20"><mxGeometry x="1560" y="150" width="660" height="140" as="geometry"/></mxCell><mxCell id="22" value="&amp;lt;&amp;lt;gateway middleware&amp;gt;&amp;gt;&#xa;&lt;b&gt;統一認證防護邊界 (Auth Shield)&lt;/b&gt;&#xa;--&#xa;• 防護目標: 自動為 Report.Service (:8085) 補足 Bearer 驗證&#xa;• 防護機制: 終止未帶 Token 之外部連線，內部轉發附帶雙向 mTLS&#xa;• 資安合規: 杜絕內部 API 裸奔存取風險" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="20"><mxGeometry x="1560" y="330" width="660" height="150" as="geometry"/></mxCell><mxCell id="23" value="&amp;lt;&amp;lt;resilience module&amp;gt;&amp;gt;&#xa;&lt;b&gt;流量限流與熔斷器 (Circuit Breaker)&lt;/b&gt;&#xa;--&#xa;• 熔斷機制: 專線抖動時主動阻斷對海外廠區的雪崩連線&#xa;• 限流策略: 針對 13 支高頻批次作業設定併發閾值&#xa;• 遙測整合: OpenTelemetry 標準指標輸出" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="20"><mxGeometry x="1560" y="520" width="660" height="140" as="geometry"/></mxCell><mxCell id="24" value="&amp;lt;&amp;lt;offline sync buffer&amp;gt;&amp;gt;&#xa;&lt;b&gt;海外廠區離線佇列轉發器&lt;/b&gt;&#xa;--&#xa;• 緩衝技術: SQLite / 本地磁碟 WAL 暫存&#xa;• 自律能力: 專線中斷 48~72 小時無感運作，通訊恢復自動補送&#xa;• 零授權費: 免費開源輕量化儲存架構" style="shape=component;align=left;spacingLeft=36;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;" vertex="1" parent="20"><mxGeometry x="1560" y="700" width="660" height="150" as="geometry"/></mxCell><mxCell id="25" value="閘道流量過濾" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="21" target="22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" value="熔斷保護監控" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="21" target="23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" value="離線封包佇列" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="21" target="24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="28" value="安全轉發至核心" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#16a34a;" edge="1" parent="1" source="22" target="13"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d03_deploy" name="03. Deployment Diagram (部署圖)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;03. UML 2.0 Deployment Diagram (部署圖) — 地端實體節點與網路拓撲&lt;/b&gt;&#xa;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;分類：結構型圖 (Structural) ｜ 專案：RSI 2027 蜂巢計畫 ｜ 資料來源：Duke 2026-11-12 交付架構 ｜ 備註：劃分三獨立子圖：台北總部機房拓撲、DYXnet 跨國專線與海外自律廠區、外部雲端與週邊整合&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;align=left;spacingLeft=20;verticalAlign=middle;fontSize=15;fontColor=#0f172a;shadow=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2220" height="55" as="geometry"/></mxCell><mxCell id="3" value="【子圖面板】子圖 A：台北總部地端核心機房 (Taipei HQ On-Premises)" style="swimlane;horizontal=1;startSize=32;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e293b;rounded=1;arcSize=4;collapsible=0;shadow=0;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="700" height="1250" as="geometry"/></mxCell><mxCell id="4" value="&amp;lt;&amp;lt;device / vm&amp;gt;&amp;gt;&#xa;&lt;b&gt;RDSMP2 (正式機)&lt;/b&gt;&#xa;--&#xa;• IP: 192.168.0.22&#xa;• OS: Windows Server 2019&#xa;• IIS 10.0 (RD_SAMPLE, 443/80)&#xa;• SQL Server 2019 Engine (:1433, SAM_DB)&#xa;• Windows Task Scheduler (13 支 .bat 排程)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="3"><mxGeometry x="80" y="150" width="640" height="180" as="geometry"/></mxCell><mxCell id="5" value="&amp;lt;&amp;lt;device / vm&amp;gt;&amp;gt;&#xa;&lt;b&gt;RDSMP1 (測試機 / 反向代理)&lt;/b&gt;&#xa;--&#xa;• IP: 192.168.0.23&#xa;• OS: Windows Server 2019&#xa;• IIS ARR 反向代理 (:8012)&#xa;• .NET 8 Kestrel Core Runtime (CQS: 8011)&#xa;• 測試環境樣品單網站 (:80)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="3"><mxGeometry x="80" y="370" width="640" height="170" as="geometry"/></mxCell><mxCell id="6" value="&amp;lt;&amp;lt;device / vm&amp;gt;&amp;gt;&#xa;&lt;b&gt;RSIMDW1 (D365 中間件伺服器)&lt;/b&gt;&#xa;--&#xa;• IP: 192.168.0.95&#xa;• OS: Windows Server 2019&#xa;• D365 Report.Service (:8085 正式 / :8082 測試)&#xa;• D365 Local.WebApi (:80 正式 / :8081 測試)&#xa;• Microsoft C# 執行階段模組" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="3"><mxGeometry x="80" y="580" width="640" height="170" as="geometry"/></mxCell><mxCell id="7" value="&amp;lt;&amp;lt;high-availability cluster&amp;gt;&amp;gt;&#xa;&lt;b&gt;AXDB 營運主庫叢集&lt;/b&gt;&#xa;--&#xa;• 節點: rsiaxdb1 (192.168.0.131) &amp; AOS (.124~.126)&#xa;• OS: Windows Server Cluster&#xa;• Microsoft SQL Server Enterprise AlwaysOn&#xa;• 承載 D365 ERP 完整企業營運財務與生產主數據" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="3"><mxGeometry x="80" y="790" width="640" height="170" as="geometry"/></mxCell><mxCell id="8" value="跨主機 ARR 代理轉送 (:8012 -&gt; :8011)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="跨主機 API 呼叫 (HTTP/8085, 80)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="4" target="6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="跨資料庫唯讀查詢 (TDS/1433, 23 處 View)" style="strokeColor=#dc2626;strokeWidth=2;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="【子圖面板】子圖 B：跨國專線 (DYXnet) 與海外邊緣自律廠區" style="swimlane;horizontal=1;startSize=32;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e293b;rounded=1;arcSize=4;collapsible=0;shadow=0;html=1;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="720" height="1250" as="geometry"/></mxCell><mxCell id="12" value="&amp;lt;&amp;lt;communication path / vpn&amp;gt;&amp;gt;&#xa;&lt;b&gt;DYXnet MPLS 跨國企業專線&lt;/b&gt;&#xa;--&#xa;• 專線架構: 第一線 (DYXnet) 企業 MPLS VPN&#xa;• 通訊埠: 直通 TCP/1433 TDS 資料庫管道&#xa;• 同步機制: 每 30 分鐘執行 Sync_RSV.bat 與 Sync_RSG.bat&#xa;• 離線容忍: 支援 48~72 小時海纜中斷自律運作" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="11"><mxGeometry x="810" y="150" width="660" height="160" as="geometry"/></mxCell><mxCell id="13" value="&amp;lt;&amp;lt;edge on-premises server&amp;gt;&amp;gt;&#xa;&lt;b&gt;越南廠 (RDV Factory Edge)&lt;/b&gt;&#xa;--&#xa;• IP: 192.168.185.123 (:1433)&#xa;• 實例: RSV_SAMPLE (SQL Server)&#xa;• 現場車縫終端: 45 台現場作業觸控機&#xa;• 邊緣自律能力: 專線中斷時本地持續生產打樣" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="11"><mxGeometry x="810" y="360" width="660" height="170" as="geometry"/></mxCell><mxCell id="14" value="&amp;lt;&amp;lt;edge on-premises server&amp;gt;&amp;gt;&#xa;&lt;b&gt;柬埔寨廠 (RDG Factory Edge)&lt;/b&gt;&#xa;--&#xa;• IP: 192.168.193.65 (:1433)&#xa;• 實例: RSG_SAMPLE (SQL Server)&#xa;• 現場車縫終端: 30 台現場作業終端&#xa;• 邊緣自律能力: 專線中斷時本地持續生產打樣" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="11"><mxGeometry x="810" y="570" width="660" height="170" as="geometry"/></mxCell><mxCell id="15" value="&amp;lt;&amp;lt;edge cache / offline db&amp;gt;&amp;gt;&#xa;&lt;b&gt;海外廠區現場自律緩衝機制&lt;/b&gt;&#xa;--&#xa;• 快取技術: 本地 SQL Server 離線作業暫存區&#xa;• 雙向補償: 專線恢復後批次上傳未同步行程&#xa;• 零授權平替: 廠區端零額外商業軟體授權負擔" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="11"><mxGeometry x="810" y="780" width="660" height="160" as="geometry"/></mxCell><mxCell id="16" value="專線傳輸 (TDS/1433 每30分鐘)" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#ea580c;strokeWidth=2;" edge="1" parent="1" source="4" target="12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="17" value="落地同步至越南" style="strokeColor=#ea580c;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="落地同步至柬埔寨" style="strokeColor=#ea580c;" edge="1" parent="1" source="12" target="14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" value="廠端自律備援" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="13" target="15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="廠端自律備援" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="【子圖面板】子圖 C：外部雲端擴充與週邊服務整合節點" style="swimlane;horizontal=1;startSize=32;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e293b;rounded=1;arcSize=4;collapsible=0;shadow=0;html=1;" vertex="1" parent="1"><mxGeometry x="1530" y="90" width="720" height="1250" as="geometry"/></mxCell><mxCell id="22" value="&amp;lt;&amp;lt;cloud service / ec2&amp;gt;&amp;gt;&#xa;&lt;b&gt;AWS AI 推論節點 (可選擴充)&lt;/b&gt;&#xa;--&#xa;• 端點: https://aws-ai.rsi.com:8000&#xa;• 負責功能: TechPack 複雜版型深度學習解析&#xa;• 連線方式: 經由總部出海口加密傳輸&#xa;• 架構原則: 地端優先，雲端僅作算力彈性擴展" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="21"><mxGeometry x="1560" y="150" width="660" height="160" as="geometry"/></mxCell><mxCell id="23" value="&amp;lt;&amp;lt;enterprise messaging&amp;gt;&amp;gt;&#xa;&lt;b&gt;集團內部郵件伺服器 (SMTP)&lt;/b&gt;&#xa;--&#xa;• 連線埠: TCP 587 (TLS 加密連線)&#xa;• 呼叫者: SendNotification.bat (每 5 分鐘執行)&#xa;• 通知範圍: 樣品異常、跨國工單逾時、品管不合格警告" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="21"><mxGeometry x="1560" y="360" width="660" height="160" as="geometry"/></mxCell><mxCell id="24" value="&amp;lt;&amp;lt;storage appliance&amp;gt;&amp;gt;&#xa;&lt;b&gt;企業儲存與備份 NAS (D:\EXP 映射)&lt;/b&gt;&#xa;--&#xa;• 協議: SMB 3.0 / NFS (Port 445)&#xa;• 路徑: \\nas.rsi.local\Sample_Archive&#xa;• 備份政策: 每日排程產出之 Excel/PDF 封存與冷備份" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="21"><mxGeometry x="1560" y="570" width="660" height="160" as="geometry"/></mxCell><mxCell id="25" value="&amp;lt;&amp;lt;client workstation&amp;gt;&amp;gt;&#xa;&lt;b&gt;設計師與業務高階工作站 (Clients)&lt;/b&gt;&#xa;--&#xa;• 硬體規格: Core i7 / 32GB RAM / 雙螢幕&#xa;• 軟體環境: Windows 11 Enterprise, Comet 瀏覽器&#xa;• 網路環境: 總部研發辦公室 Intranet LAN (192.168.1.x)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;fontColor=#0f172a;" vertex="1" parent="21"><mxGeometry x="1560" y="780" width="660" height="160" as="geometry"/></mxCell><mxCell id="26" value="模型推論呼叫 (HTTPS/8000)" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="4" target="22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" value="排程寄送通知 (SMTP/587)" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="4" target="23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="28" value="產出文件歸檔 (SMB/445)" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="4" target="24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="29" value="瀏覽器存取操作 (HTTPS/443)" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#0284c7;" edge="1" parent="1" source="25" target="4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d04_package" name="04. Package Diagram (套件圖)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;04. UML 2.0 Package Diagram (套件圖) — 模組化命名空間與依賴架構&lt;/b&gt;&#xa;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;分類：結構型圖 (Structural) ｜ 專案：RSI 2027 蜂巢計畫 ｜ 資料來源：Duke 2026-11-12 交付架構 ｜ 備註：劃分三獨立子圖：RD_SAMPLE 系統套