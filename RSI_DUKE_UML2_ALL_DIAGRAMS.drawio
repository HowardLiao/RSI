/></mxCell><mxCell id="24" value="&lt;b&gt;專線連線復原中 (Reconnecting)&lt;/b&gt;&#xa;--&#xa;entry / 偵測到 TDS 握手回應&#xa;do / 鎖定暫存佇列以防併發衝突" style="rounded=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;;html=1;" vertex="1" parent="20"><mxGeometry x="1680" y="360" width="260" height="90" as="geometry"/></mxCell><mxCell id="25" value="&lt;b&gt;資料雙向補償同步 (Resyncing)&lt;/b&gt;&#xa;--&#xa;entry / 循序補送斷網期間工單&#xa;do / 消除差異並重新校驗 Checksum" style="rounded=1;arcSize=10;fillColor=#ffedd5;strokeColor=#ea580c;;html=1;" vertex="1" parent="20"><mxGeometry x="1300" y="360" width="250" height="90" as="geometry"/></mxCell><mxCell id="26" value="初始化建立連線" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="21" target="22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" value="連續 3 次同步逾時" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="22" target="23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="28" value="海纜/專線信號恢復" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="23" target="24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="29" value="連線穩定確認" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="24" target="25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="30" value="差異對齊完畢" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="25" target="22"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d11_sequence" name="11. Sequence Diagram (循序圖)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="1