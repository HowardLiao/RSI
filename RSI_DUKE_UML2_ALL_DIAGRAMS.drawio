"9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="【子圖面板】子圖 B：跨國專線異常之條件決策與離線補償分支" style="swimlane;horizontal=1;startSize=32;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e293b;rounded=1;arcSize=4;collapsible=0;shadow=0;html=1;" vertex="1" parent="1"><mxGeometry x="1170" y="90" width="1080" height="1250" as="geometry"/></mxCell><mxCell id="16" value="專線狀態？" style="rhombus;fillColor=#fef3c7;strokeColor=#d97706;;html=1;" vertex="1" parent="15"><mxGeometry x="1240" y="200" width="80" height="60" as="geometry"/></mxCell><mxCell id="17" value="&lt;b&gt;sd: 正常每 30 分鐘同步&lt;/b&gt;&#xa;--&#xa;直連 TDS 1433 寫入廠端&#xa;耗時 &lt; 2 秒，即時確認" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#16a34a;;html=1;" vertex="1" parent="15"><mxGeometry x="1400" y="150" width="280" height="110" as="geometry"/></mxCell><mxCell id="18" value="&lt;b&gt;sd: 48~72hr 離線自律流程&lt;/b&gt;&#xa;--&#xa;啟動廠區本地暫存緩衝&#xa;SendNotification 發出警告" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#dc2626;;html=1;" vertex="1" parent="15"><mxGeometry x="1400" y="320" width="280" height="110" as="geometry"/></mxCell><mxCell id="19" value="&lt;b&gt;sd: 專線復原雙向補償&lt;/b&gt;&#xa;--&#xa;循序補送暫存交易&#xa;校驗雙邊資料一致性" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#ea580c;;html=1;" vertex="1" parent="15"><mxGeometry x="1760" y="230" width="280" height="110" as="geometry"/></mxCell><mxCell id="20" value="[連線良好]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="[海纜中斷]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="16" target="18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="22" value="完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="17" target="19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="23" value="連線恢復" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="18" target="19"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d14_timing" name="14. Timing Diagram (時序圖)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;14. UML 2.0 Timing Diagram (時序圖) — 24小時批次波形與海纜中斷恢復時序&lt;/b&gt;&#xa;&lt;font style='font-size:11px;font-weight:normal;color:#475569;'&gt;分類：行為型圖 (Behavioral) ｜ 專案：RSI 2027 蜂巢計畫 ｜ 資料來源：Duke 2026-11-12 交付架構 ｜ 備註：劃分二獨立子圖：24小時Windows排程執行波形、海纜中斷事件與48~72hr自律時序波形 (真實向量階梯繪製)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;align=left;spacingLeft=20;verticalAlign=middle;fontSize=15;fontColor=#0f172a;shadow=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2220" height="55" as="geometry"/></mxCell><mxCell id="3" value="【子圖面板】子圖 A：台北總部 13 支 Windows 批次排程 24 小時執行波形 (階梯向量繪製)" style="swimlane;horizontal=1;startSize=32;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e293b;rounded=1;arcSize=4;collapsible=0;shadow=0;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="1080" height="1250" as="geometry"/></mxCell><mxCell id="4" value="時間刻度：00:00 ── 06:00 ── 12:00 ── 18:00 ── 23:01 ── 23:31 ── 24:00" style="fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=11;fontStyle=1;align=center;;html=1;" vertex="1" parent="3"><mxGeometry x="250" y="140" width="780" height="35" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;SendNotification.bat&lt;/b&gt;&#xa;[每 5 分鐘執行]&#xa;狀態: High=執行, Low=休眠" style="rounded=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontSize=10;align=center;;html=1;" vertex="1" parent="3"><mxGeometry x="80" y="200" width="160" height="90" as="geometry"/></mxCell><mxCell id="6" value="全天 24 小時高頻脈衝 (每 5 分鐘喚醒一次，掃描待寄送郵件，執行時間約 2~5 秒後回到休眠態)&#xa;狀態波形: _∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_∏_" style="fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;fontFamily=monospace;fontSize=11;align=center;;html=1;" vertex="1" parent="3"><mxGeometry x="250" y="200" width="780" height="90" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;Sync_RSV / RSG.bat&lt;/b&gt;&#xa;[每 30 分鐘執行]&#xa;狀態: High=傳輸, Low=休眠" style="rounded=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=10;align=center;;html=1;" vertex="1" parent="3"><mxGeometry x="80" y="320" width="160" height="90" as="geometry"/></mxCell><mxCell id="8" value="全天每 30 分鐘固定發送 TDS 專線封包 (執行時間約 15~45 秒，遇網路延遲最高容許 180 秒逾時)&#xa;狀態波形: ___|▔▔|___|▔▔|___|▔▔|___|▔▔|___|▔▔|___|▔▔|___|▔▔|___|▔▔|___|▔▔|___|▔▔|___" style="fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;fontFamily=monospace;fontSize=11;align=center;;html=1;" vertex="1" parent="3"><mxGeometry x="250" y="320" width="780" height="90" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;夜間 ERP 批次組&lt;/b&gt;&#xa;[23:01 ~ 23:31]&#xa;含 Export_Sam, 日報表等" style="rounded=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=10;align=center;;html=1;" vertex="1" parent="3"><mxGeometry x="80" y="440" width="160" height="90" as="geometry"/></mxCell><mxCell id="10" value="日間低負載休眠 ──────────────────────────────────────────────&gt; [23:01~23:31 持續密集高負載]&#xa;狀態波形: ____________________________________________________________________|▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔|___" style="fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=1.5;fontFamily=monospace;fontSize=11;align=center;;html=1;" vertex="1" parent="3"><mxGeometry x="250" y="440" width="780" height="90" as="geometry"/></mxCell><mxCell id="11" value="【子圖面板】子圖 B：海纜中斷事件與 48~72 小時在地自律運轉時序波形" style="swimlane;horizontal=1;startSize=32;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e293b;rounded=1;arcSize=4;collapsible=0;shadow=0;html=1;" vertex="1" parent="1"><mxGeometry x="1170" y="90" width="1080" height="1250" as="geometry"/></mxCell><mxCell id="12" value="時間刻度：T0(海纜切斷) ── T+1h ── T+24h ── T+48h ── T+72h(專線修復) ── T+74h(對齊完畢)" style="fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=11;fontStyle=1;align=center;;html=1;" vertex="1" parent="11"><mxGeometry x="1370" y="140" width="780" height="35" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;DYXnet 專線通道&lt;/b&gt;&#xa;狀態: 正常 / 中斷" style="rounded=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=10;align=center;;html=1;" vertex="1" parent="11"><mxGeometry x="1200" y="200" width="160" height="90" as="geometry"/></mxCell><mxCell id="14" value="[T0 專線中斷 0 Mbps 斷開] ──────────────────────────────────────────&gt; [T+72h 海纜修復 100 Mbps]&#xa;波形: ▔▔▔▔▔▔▔|____________________________________________________________________|▔▔▔▔▔▔▔▔▔▔▔▔" style="fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=1.5;fontFamily=monospace;fontSize=11;align=center;;html=1;" vertex="1" parent="11"><mxGeometry x="1370" y="200" width="780" height="90" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;廠區自律生產作業&lt;/b&gt;&#xa;狀態: 100% 離線可用" style="rounded=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=10;align=center;;html=1;" vertex="1" parent="11"><mxGeometry x="1200" y="320" width="160" height="90" as="geometry"/></mxCell><mxCell id="16" value="[廠區本地快取持續維持 100% 生產打樣運轉，無中斷、無當機，離線資料寫入本地 SQLite/SQL 暫存區]&#xa;波形: ▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔" style="fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontFamily=monospace;fontSize=11;align=center;;html=1;" vertex="1" parent="11"><mxGeometry x="1370" y="320" width="780" height="90" as="geometry"/></mxCell><mxCell id="17" value="&lt;b&gt;資料雙向補償進度&lt;/b&gt;&#xa;狀態: 佇列累積 / 沖銷" style="rounded=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=10;align=center;;html=1;" vertex="1" parent="11"><mxGeometry x="1200" y="440" width="160" height="90" as="geometry"/></mxCell><mxCell id="18" value="[0筆] ────&gt; [T+24h 累積50筆] ────&gt; [T+48h 累積120筆] ────&gt; [T+72h 啟動對齊沖銷] ────&gt; [T+74h 歸零對齊]&#xa;波形: _________/▔▔▔▔▔▔▔▔▔▔▔▔▔▔/▔▔▔▔▔▔▔▔▔▔▔▔▔▔/▔▔▔▔▔▔▔▔▔▔▔▔▔▔\________________________" style="fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;fontFamily=monospace;fontSize=11;align=center;;html=1;" vertex="1" parent="11"><mxGeometry x="1370" y="440" width="780" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram>
