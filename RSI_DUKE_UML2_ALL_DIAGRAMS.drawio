stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;" vertex="1" parent="3"><mxGeometry x="80" y="940" width="640" height="200" as="geometry"/></mxCell><mxCell id="8" value="回傳封裝" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="6" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="使用參數基底" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="6" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="回傳封裝" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="7" target="5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="使用參數基底" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="7" target="4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="【子圖面板】子圖 B：RD_SAMPLE 樣品單與打樣明細核心領域模型" style="swimlane;horizontal=1;startSize=32;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#1e293b;rounded=1;arcSize=4;collapsible=0;shadow=0;html=1;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="720" height="1250" as="geometry"/></mxCell><mxCell id="13" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&#xa;&lt;b&gt;MoHeader&lt;/b&gt;&#xa;--&#xa;+ MoNo : string [PK]&#xa;+ Season : string&#xa;+ Brand : string&#xa;+ Stage : string&#xa;+ CreatedBy : string&#xa;+ CreatedAt : DateTime&#xa;+ CurrentStatus : SampleStatusEnum&#xa;+ FactoryId : string&#xa;--&#xa;+ CalculateDueDate() : DateTime&#xa;+ AssignFactory(factoryId: string) : void&#xa;+ CanDispatch() : bool" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;" vertex="1" parent="12"><mxGeometry x="810" y="140" width="660" height="220" as="geometry"/></mxCell><mxCell id="14" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&#xa;&lt;b&gt;MoDetail&lt;/b&gt;&#xa;--&#xa;+ DetailId : int [PK]&#xa;+ MoNo : string [FK]&#xa;+ PartName : string&#xa;+ ColorCode : string&#xa;+ FabricSpec : string&#xa;+ ConsumptionRate : decimal&#xa;+ MarkerLength : decimal&#xa;--&#xa;+ ComputeConsumption() : decimal&#xa;+ VerifyInventory() : bool" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;" vertex="1" parent="12"><mxGeometry x="810" y="400" width="660" height="200" as="geometry"/></mxCell><mxCell id="15" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&#xa;&lt;b&gt;TechPackAttachment&lt;/b&gt;&#xa;--&#xa;+ FileId : Guid&#xa;+ MoNo : string [FK]&#xa;+ FileName : string&#xa;+ FileSize : long&#xa;+ ParsedJsonContent : string&#xa;+ ParseStatus : string&#xa;+ ExtractedAt : DateTime&#xa;--&#xa;+ TriggerCliParser() : bool&#xa;+ GetParsedBom() : List&lt;BomItemDto&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=11;" vertex="1" parent="12"><mxGeometry x="810" y="640" width="660" height="200" as="geometry"/></mxCell><mxCell id="16" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&#xa;&lt;b&gt