<mxCell id="c6" value="&lt;b style=&quot;color:#38BDF8&quot;&gt;A&lt;/b&gt;　&lt;b style=&quot;color:#F8FAFC&quot;&gt;業務系統整合&lt;/b&gt;　同步 API 呼叫" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans TC;fontSize=13;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="600" height="24" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC&quot;&gt;呼叫端系統&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;總部・工廠・合作系統&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;以 API 存取 ERP 業務資料&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0B1428;strokeColor=#F59E0B;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="210" height="125" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC&quot;&gt;Azure API Management&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;認證・限流・版本・Policy&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;OpenAPI 文件集中管理&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F87171&quot;&gt;不取代業務整合邏輯&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0B1428;strokeColor=#38BDF8;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="230" height="125" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC&quot;&gt;整合服務／業務邏輯&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;資料轉換・驗證・錯誤處理&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;程式碼與設定由 RSI 持有&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0B1428;strokeColor=#38BDF8;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="590" y="60" width="250" height="125" as="geometry"/></mxCell>
