<mxCell id="c2" value="&lt;b style=&quot;font-size:24px;color:#F8FAFC&quot;&gt;RSI 資料整合架構：APIM＋ADF＋ADLS Gen2&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans TC;fontSize=24;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="10" y="-110" width="1180" height="40" as="geometry"/></mxCell>
<mxCell id="c3" value="第一階段・Azure 原生｜D365 走官方支援路徑，工廠自有 MS SQL 走 ADF 擷取｜以 D365 F&amp;amp;SCM 雲端版示意" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans TC;fontSize=13;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="10" y="-72" width="1180" height="24" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b style=&quot;color:#F87171&quot;&gt;生命週期風險&lt;/b&gt;　F&amp;amp;SCM 舊版 Export to Data Lake 於 2026-11-30 停止匯出新資料與異動（不代表 Synapse Link／Link to Fabric 停用）。請 D365 廠商先盤點。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#2A0F14;strokeColor=#F87171;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;spacingTop=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="-40" width="1180" height="30" as="geometry"/></mxCell>
