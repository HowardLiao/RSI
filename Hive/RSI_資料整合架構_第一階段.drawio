<mxCell id="c42" value="擇一" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94A3B8;fontFamily=Noto Sans TC;fontSize=11;fontColor=#94A3B8;labelBackgroundColor=#0F172A;dashed=1;" edge="1" parent="1" source="c26" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c43" value="&lt;b style=&quot;color:#F8FAFC&quot;&gt;D365 類型待確認&lt;/b&gt;（決定 D365 擷取路徑）&lt;br&gt;• &lt;b style=&quot;color:#F8FAFC&quot;&gt;F&amp;amp;SCM 雲端&lt;/b&gt;：Data Entities／OData；分析用 Synapse Link 或 Link to Fabric（本圖）&lt;br&gt;• &lt;b style=&quot;color:#F8FAFC&quot;&gt;Business Central&lt;/b&gt;：官方 REST API v2.0；大量分析擷取需另驗證，不沿用 F&amp;amp;SCM 同步架構&lt;br&gt;• &lt;b style=&quot;color:#F8FAFC&quot;&gt;D365 地端&lt;/b&gt;：依產品與版本確認介面，F&amp;amp;O 地端版 API 限制不同" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0F172A;strokeColor=#F59E0B;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="10" y="660" width="760" height="92" as="geometry"/></mxCell>
<mxCell id="c44" value="&lt;b style=&quot;color:#F8FAFC&quot;&gt;圖例&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#38BDF8&quot;&gt;━━&lt;/span&gt; 第一階段導入（Azure 原生）&lt;br&gt;&lt;span style=&quot;color:#F59E0B&quot;&gt;▢&lt;/span&gt; 來源系統　&lt;span style=&quot;color:#94A3B8&quot;&gt;┅┅&lt;/span&gt; 替代路線或待驗證&lt;br&gt;&lt;span style=&quot;color:#F87171&quot;&gt;▢&lt;/span&gt; 限制與風險" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0F172A;strokeColor=#1E3A5F;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="790" y="660" width="400" height="92" as="geometry"/></mxCell>
<mxCell id="c45" value="Howard Liao Ph.D. · 2026-10-17 · 產品能力依 Microsoft 官方文件；「較易技轉」為架構判斷，未經實測證明成本最低。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans TC;fontSize=11;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="10" y="760" width="1180" height="22" as="geometry"/></mxCell>
