<mxCell id="c20" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC&quot;&gt;D365 F&amp;amp;SCM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;雲端 SaaS・ERP 資料&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;不可視為自管 SQL Server&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0B1428;strokeColor=#F59E0B;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="30" y="298" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;span style=&quot;color:#F87171&quot;&gt;限制：不直接對 ERP 底層&lt;br&gt;開 SQL CDC 或裝 Debezium&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#2A0F14;strokeColor=#F87171;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="210" height="46" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC&quot;&gt;工廠／周邊 MS SQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;地端・自有資料庫&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;依版本・權限・負載・&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;日誌保留設計 CDC&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0B1428;strokeColor=#F59E0B;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="30" y="476" width="210" height="140" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC&quot;&gt;官方同步路徑&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:IBM Plex Mono,monospace;color:#38BDF8&quot;&gt;Azure Synapse Link&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;或 Link to Fabric（擇一）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0B1428;strokeColor=#38BDF8;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="300" y="298" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC&quot;&gt;Azure Data Factory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;Watermark 增量 或 SQL CDC&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;排程：ADF Pipeline&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#F87171&quot;&gt;Native CDC 部分為 Preview&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0B1428;strokeColor=#38BDF8;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="230" height="176" as="geometry"/></mxCell>
