<mxCell id="c33" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC&quot;&gt;查詢層&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;SQL 查詢層，依需求評估&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;不是裝好 ADLS 就自動有&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0B1428;strokeColor=#1E3A5F;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="900" y="298" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c34" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC&quot;&gt;既有 BI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;第一階段保留，不重做&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;報表改接查詢層／彙總層&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#0B1428;strokeColor=#1E3A5F;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="900" y="404" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c35" value="&lt;b style=&quot;font-size:14px;color:#F8FAFC&quot;&gt;替代路線：Microsoft Fabric&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:IBM Plex Mono,monospace;color:#38BDF8&quot;&gt;Link to Fabric → OneLake&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;同批資料 PoC，與 ADLS 擇一&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=12;fontColor=#94A3B8;dashed=1;dashPattern=6 5;" vertex="1" parent="1"><mxGeometry x="900" y="514" width="270" height="102" as="geometry"/></mxCell>
