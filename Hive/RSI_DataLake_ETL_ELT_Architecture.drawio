        <mxCell id="seq12" value="12. 傳回高階戰情儀表 (周副總與決策層即時掌握產銷全貌)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#15803D;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="ll-dwh" target="ll-bi">
          <mxGeometry relative="1" as="geometry">
