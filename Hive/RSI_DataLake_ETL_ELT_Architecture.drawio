        <mxCell id="seq11" value="11. 聯銓 BI 載入 Gold 主題市集 (直連 BI Engine 快取，查詢耗時 &lt; 1s)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#15803D;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="ll-bi" target="ll-dwh">
          <mxGeometry relative="1" as="geometry">
