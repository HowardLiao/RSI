<mxfile host="app.diagrams.net" agent="HowardAgent" version="21.6.8"><diagram id="rsi-hardware-deployment-diagram" name="RSI_Global_Hardware_Deployment"><mxGraphModel dx="2400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="2400" background="#0b1120"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="101" parent="1" value="&lt;div style='font-family:Arial,sans-serif; text-align:left;'&gt;&lt;div style='font-size:24px; font-weight:bold; color:#f8fafc; letter-spacing:1px;'&gt;信源全球（RSI Group） Project Hive 全球混合雲實體硬體部署架構圖 (UML 2.0 Hardware Deployment)&lt;/div&gt;&lt;div style='font-size:13px; color:#94a3b8; margin-top:4px;'&gt;核心節點：台北內湖總部核心機房 ｜ 越南同奈廠 (RDV) ｜ 柬埔寨柴楨廠 (RDG) ｜ AWS 雲端混合運算節點 ｜ 跨國 MPLS + IPsec VPN 雙軌拓撲&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=#1e293b;strokeColor=#3b82f6;strokeWidth=2;rounded=1;shadow=1;spacingLeft=20;" vertex="1"><mxGeometry x="60" y="40" width="3660" height="70" as_="geometry" /></mxCell><mxCell id="102" parent="1" value="&lt;div style='font-family:Arial,sans-serif; font-size:11px; color:#cbd5e1; line-height:1.6;'&gt;&lt;b style='color:#38bdf8; font-size:12px;'&gt;【圖例與通訊矩陣標準標示說明】&lt;/b&gt;&lt;br/&gt;&lt;span style='display:inline-block; width:10px; height:10px; background:#10b981; border-radius:50%; margin-right:4px;'&gt;&lt;/span&gt;主機正常運作 / Link Active &amp;nbsp;&amp;nbsp;&lt;span style='display:inline-block; width:10px; height:10px; background:#3b82f6; border-radius:50%; margin-right:4px;'&gt;&lt;/span&gt;iDRAC / System ID LED &amp;nbsp;&amp;nbsp;&lt;span style='display:inline-block; width:10px; height:10px; background:#f59e0b; border-radius:50%; margin-right:4px;'&gt;&lt;/span&gt;RAID 快取 / Fault LED &amp;nbsp;&amp;nbsp;&lt;span style='color:#f43f5e; font-weight:bold;'&gt;━ ━&lt;/span&gt; MPLS 專線 (100M/50M) &amp;nbsp;&amp;nbsp;&lt;span style='color:#38bdf8; font-weight:bold;'&gt;━━━&lt;/span&gt; IPsec VPN (UDP 500/4500) &amp;nbsp;&amp;nbsp;&lt;span style='color:#a855f7; font-weight:bold;'&gt;━━━&lt;/span&gt; 10GbE iSCSI SAN Fabric (Port 3260) &amp;nbsp;&amp;nbsp;&lt;span style='color:#10b981; font-weight:bold;'&gt;━━━&lt;/span&gt; 25GbE RoCE / Trunk LAN&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=#0f172a;strokeColor=#475569;strokeWidth=1;rounded=1;spacingLeft=15;" vertex="1"><mxGeometry x="2680" y="45" width="1020" height="60" as_="geometry" /></mxCell><mxCell id="103" parent="1" value="台北內湖總部核心機房 (Taipei Neihu HQ Data Center) ｜ IP 網段: 192.168.0.0/24 &amp; 10.10.0.0/16" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;recursiveResize=0;fillColor=#090d16;strokeColor=#3b82f6;strokeWidth=2.5;rounded=1;shadow=1;fontFamily=Arial;fontColor=#93c5fd;fontSize=16;fontStyle=1;startSize=36;swimlaneFillColor=#060911;" vertex="1"><mxGeometry x="60" y="140" width="2200" height="1520" as_="geometry" /></mxCell><mxCell id="104" parent="103" value="" style="" /><mxCell id="105" parent="103" value="«appliance» FortiGate 200F [HQ Core NGFW / SD-WAN Controller]" style="swimlane;html=1;whiteSpace=wrap;collapsible=0;fillColor=#1e293b;strokeColor=#0284c7;strokeWidth=2;rounded=1;fontFamily=Arial;fontColor=#38bdf8;fontSize=12;fontStyle=1;startSize=26;swimlaneFillColor=#090d16;" vertex="1"><mxGeometry x="20" y="50" width="1060" height="140" as_="geometry" /></mxCell><mxCell id="106" parent="105" value="" style="rounded=1;fillColor=#111827;strokeColor=#374151;strokeWidth=1;" vertex="1"><mxGeometry x="10" y="32" width="1040" height="44" as_="geometry" /></mxCell><mxCell id="107" parent="106" value="" style="rounded=0;fillColor=#64748b;" vertex="1"><mxGeometry x="0" y="0" width="10" height="44" as_="geometry" /></mxCell><mxCell id="108" parent="106" value="" style="rounded=0;fillColor=#64748b;" vertex="1"><mxGeometry x="1030" y="0" width="10" height="44" as_="geometry" /></mxCell><mxCell id="109" parent="106" value="&lt;b style='color:#38bdf8;font-size:9px;'&gt;FortiGate 200F&lt;/